<launch>
  <arg name="experiment_config" default="$(find hri_legibility_preview)/config/experiment.lab.yaml" />
  <arg name="moveit_ns" default="/" />
  <arg name="planner_id" default="" />
  <arg name="planning_pipeline_id" default="ompl" />
  <arg name="planner_configs_param" default="/move_group/planner_configs" />
  <arg name="group_planners_param" default="/move_group/arm/planner_configs" />
  <arg name="baseline_mode" default="rrtconnect" />
  <!-- Enable when the group package containing TrialInfo is built and sourced. -->
  <arg name="subscribe_group_trials" default="false" />
  <group ns="legibility_preview">
    <node pkg="hri_legibility_preview" type="layout_publisher.py" name="block_layout" output="screen" required="true">
      <param name="experiment_config" value="$(arg experiment_config)" />
    </node>
    <node pkg="hri_legibility_preview" type="optimizer_node.py" name="optimizer" output="screen" required="true">
      <param name="experiment_config" value="$(arg experiment_config)" />
      <param name="moveit_ns" value="$(arg moveit_ns)" />
      <param name="support_points" value="11" />
      <param name="max_joint_deviation_rad" value="0.08" />
      <param name="cost_ratio" value="1.2" />
    </node>
    <node pkg="hri_legibility_preview" type="planner_node.py" name="planner" output="screen" required="true">
      <param name="experiment_config" value="$(arg experiment_config)" />
      <param name="moveit_ns" value="$(arg moveit_ns)" />
      <param name="planner_id" value="$(arg planner_id)" />
      <param name="planning_pipeline_id" value="$(arg planning_pipeline_id)" />
      <param name="planner_configs_param" value="$(arg planner_configs_param)" />
      <param name="group_planners_param" value="$(arg group_planners_param)" />
      <param name="baseline_mode" value="$(arg baseline_mode)" />
      <param name="subscribe_group_trials" value="$(arg subscribe_group_trials)" />
    </node>
  </group>
</launch>
